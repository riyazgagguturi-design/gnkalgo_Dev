{
  "name": "GNK Algo",
  "user": "ubuntu",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "install": "./scripts/cloud-agent-install.sh",
  "start": "./scripts/cloud-agent-start.sh",
  "ports": [
    {
      "name": "frontend",
      "port": 3000
    },
    {
      "name": "backend",
      "port": 8000
    }
  ],
  "terminals": [
    {
      "name": "backend",
      "command": "./scripts/cloud-agent-backend.sh",
      "description": "FastAPI backend on port 8000"
    },
    {
      "name": "frontend",
      "command": "./scripts/cloud-agent-frontend.sh",
      "description": "Vite dev server on port 3000"
    }
  ]
}
