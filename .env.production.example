# Production / developer staging — copy to .env (never commit real secrets)

APP_NAME=GnKAlgo
APP_ENV=production
DEBUG=false
SECRET_KEY=replace-with-64-char-random
ENCRYPTION_KEY=replace-with-32-plus-char-random

POSTGRES_USER=gnkalgo
POSTGRES_PASSWORD=replace-strong-db-password
POSTGRES_DB=gnkalgo

FRONTEND_URL=https://dev.gnkalgo.com
BACKEND_PUBLIC_URL=https://api-dev.gnkalgo.com
NEXT_PUBLIC_API_URL=https://api-dev.gnkalgo.com
ALLOWED_ORIGINS=https://dev.gnkalgo.com,https://www.gnkalgo.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

ML_SERVICE_URL=http://ml-service:8001

DHAN_API_BASE_URL=https://api.dhan.co/v2
GROWW_API_BASE_URL=https://api.groww.in
